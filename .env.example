# =============================================================================
# Sol Next v9.0.4 Public Edition — BYOK & Automation Environment Reference
# =============================================================================
# IMPORTANT:
# 1. Sol Next Public Edition (package: ai.sol.next) includes free built-in
#    Rust-encrypted DeepSeek V4.1 Flash out of the box (zero plaintext keys),
#    and lets you optionally override with ANY OpenAI-compatible BYOK API key.
# 2. End users configure optional BYOK directly inside the Android app:
#      Sol Next -> Settings (设置) -> "模型 API 配置 (BYOK)"
# 3. Copy this file to `.env` ONLY for local automation scripts / documentation;
#    NEVER commit `.env` or any real key to Git.

# -----------------------------------------------------------------------------
# Primary LLM Provider (Required inside the App for chat & phone automation)
# Compatible with ANY OpenAI Chat Completions API endpoint.
# -----------------------------------------------------------------------------
# [REQUIRED] Base URL ending in /v1 (do NOT append /chat/completions)
# Examples:
#   DeepSeek Official : https://api.deepseek.com/v1
#   OpenAI Official   : https://api.openai.com/v1
#   OpenRouter        : https://openrouter.ai/api/v1
#   SiliconFlow (CN)  : https://api.siliconflow.cn/v1
#   Qwen DashScope    : https://dashscope.aliyuncs.com/compatible-mode/v1
SOL_API_BASE_URL=https://api.deepseek.com/v1

# [REQUIRED] Model ID matching your chosen provider
# Examples: deepseek-chat | gpt-4o-mini | deepseek/deepseek-chat | deepseek-ai/DeepSeek-V3 | qwen-plus
SOL_MODEL_ID=deepseek-chat

# [REQUIRED] Your own API key (stored strictly on-device in Sol Next; never sent to third parties)
SOL_API_KEY=sk-replace-with-your-own-api-key

# -----------------------------------------------------------------------------
# Optional: AI Phone Call Realtime Voice Credentials (BYOK)
# Configured in App -> Side Drawer -> "AI 接打电话助手" -> "代接设置"
# -----------------------------------------------------------------------------
# [OPTIONAL] Protocol: volcengine (Seeduplex 3.0) | openai (OpenAI Realtime API)
SOL_VOICE_PROTOCOL=volcengine

# [OPTIONAL - for Volcengine Seeduplex 3.0] Your Volcengine Realtime Voice App ID & Access Key
SOL_VOLC_APP_ID=
SOL_VOLC_ACCESS_KEY=

# [OPTIONAL - for OpenAI Realtime] Your OpenAI Realtime-enabled API Key
SOL_OPENAI_REALTIME_KEY=

# -----------------------------------------------------------------------------
# Optional: PC-to-Phone CLI & MCP Server Settings (scripts/sol-cli.py, mcp/sol_mcp_server.py)
# -----------------------------------------------------------------------------
# [OPTIONAL] Specific ADB device serial (leave empty to auto-select single connected device)
# Format example: emulator-5592 or 192.168.1.50:37891
SOL_ADB_SERIAL=

# [OPTIONAL] Target APK ABI for scripts/sol-cli.py install: arm64 (default) | universal
SOL_APK_ABI=arm64
